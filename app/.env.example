# Database. A local file in development and in previews; a libsql:// URL
# (Turso) in production, where DATABASE_AUTH_TOKEN is then required.
DATABASE_URL=file:./sejjel.db
DATABASE_AUTH_TOKEN=

# Sessions. Required in every deployment, staging included: without it no
# session can be verified and every page fails. At least 32 random characters,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# The app's own URL, so Better Auth can build absolute links.
APP_URL=http://localhost:3000

# What an empty database gets on deploy: a scenario name, or nothing to leave
# it empty. Never applied in production. `npm run db:seed -- --list` names them.
SEED_SCENARIO=poc

# Providers. The fakes are development only: production refuses to start on
# them. Disk storage is the real implementation everywhere, pointed at the
# mounted volume in production.
# Which deployment this is: development, preview, test or production.
APP_ENV=development

OTP_PROVIDER=log
PAYMENTS_PROVIDER=fake
PUSH_PROVIDER=log
STORAGE_PROVIDER=disk
STORAGE_ROOT=./storage/invoices
